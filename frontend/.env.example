# Gemma Compute Monitor - Frontend environment template
# For local dev, copy to frontend/.env.local. On Railway, set these in the
# project's environment variables.

# Backend base URL the browser EventSource connects to.
# In production this is the per-session ngrok HTTPS URL (see COMPUTE_MONITOR.md).
NEXT_PUBLIC_API_URL=https://your-ngrok-subdomain.ngrok-free.app

# Single shared password compared client-side against the localStorage value.
NEXT_PUBLIC_PASSWORD=change-me
