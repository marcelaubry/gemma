# Gemma Compute Monitor — backend environment template.
# Copy to .env and fill in values. Do NOT commit real secrets.
#
# This file documents the backend's environment-variable contract. The backend
# settings module (backend/app/config.py) reads these exact variable names.
# Frontend (browser-exposed) variables belong in frontend/.env.example, NOT here.
#
# dotenv syntax: KEY=value, one per line, no spaces around '=' on active
# entries, and comments start with '#'.

# -----------------------------------------------------------------------------
# REQUIRED — model weights
# -----------------------------------------------------------------------------
# REQUIRED. Absolute local filesystem path to the downloaded Gemma 3 4B Orbax
# checkpoint directory. Loaded once during FastAPI startup by the model loader:
#     gm.ckpts.load_params(GEMMA_WEIGHTS_PATH, text_only=True)
# Leave the obvious placeholder below unchanged in version control so that the
# lifespan model-load fails loudly if this is not replaced with a real path.
GEMMA_WEIGHTS_PATH=/absolute/path/to/gemma3-4b

# -----------------------------------------------------------------------------
# CORS — cross-origin allow-list
# -----------------------------------------------------------------------------
# Comma-separated allow-list of browser origins permitted to call the API.
# Include the live Railway frontend origin PLUS your local dev origin:
#   - Railway production frontend:  https://<your-app>.up.railway.app
#   - Local development:            http://localhost:3000
# The public frontend is served cross-origin from this local backend (reached
# through a per-session ngrok HTTPS tunnel), so the Railway origin MUST be named
# here explicitly. In addition to this allow-list, the backend permits
# permissive local origins for development.
CORS_ALLOW_ORIGINS=https://<your-app>.up.railway.app,http://localhost:3000

# -----------------------------------------------------------------------------
# OPTIONAL — server + runtime tuning
# -----------------------------------------------------------------------------
# Optional. Port that uvicorn binds the FastAPI app to (default 8000). The
# backend is exposed to the public frontend via an ngrok HTTPS tunnel to this
# same port (e.g. `ngrok http 8000`).
PORT=8000

# Optional. Leave COMMENTED OUT by default. Only set this if a newer (but still
# jax-metal==0.1.1-compatible, approximately 0.5.0) jaxlib is used and PJRT
# compatibility is required — see backend/README.md and the jax/jaxlib
# compatibility note in backend/requirements.txt. NEVER set this as a workaround
# for upgrading jax-metal.
# ENABLE_PJRT_COMPATIBILITY=1
