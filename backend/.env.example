# Gemma Compute Monitor - Backend environment template
# Copy to backend/.env (or export in your shell) and fill in real values.

# Absolute path to the Gemma 3 4B Orbax checkpoint directory.
# Consumed by gm.ckpts.load_params(GEMMA_WEIGHTS_PATH, text_only=True).
GEMMA_WEIGHTS_PATH=/absolute/path/to/gemma3-4b/checkpoint

# Model identifier reported by GET /health.
MODEL_ID=gemma-3-4b

# CORS allow-list. Comma-separated origins. Include your live Railway origin.
# Local development is permissive by default in the app.
CORS_ALLOW_ORIGINS=https://your-app.up.railway.app,http://localhost:3000

# Port uvicorn binds to (ngrok tunnels this port).
PORT=8000
